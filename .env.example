# Aetheron — environment template
#
# Copy to .env for local development:   cp .env.example .env
# In production every one of these is set as a Railway variable instead.
# Nothing in this repo is hardcoded; if a value belongs in config, it lives here.


# ══════════════════════════════════════════════════════════════════
#  REQUIRED — the app will not boot without these
# ══════════════════════════════════════════════════════════════════

# Solana wallet that receives every payment. Mandatory by design: booting
# without it would silently route funds to the wrong place.
PAYMENT_WALLET=

# Powers all five AI tools.
OPENAI_API_KEY=

# Celery broker + result backend. Local default shown.
REDIS_URL=redis://localhost:6379/0


# ══════════════════════════════════════════════════════════════════
#  SOLANA
# ══════════════════════════════════════════════════════════════════

# Defaults to the public mainnet RPC, which is heavily rate limited.
# Use the Helius RPC URL in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana RPC + token holder lookups (contract-intel, risk-engine).
HELIUS_API_KEY=

# Leave EMPTY until the relaunched token exists.
# Setting this activates AETH payments across the whole app with no redeploy:
# while it is empty the AETH option is hidden and everything stays USDC-only.
AETH_MINT_ADDRESS=

# Canonical mainnet USDC mint. Only change this to target devnet.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v


# ══════════════════════════════════════════════════════════════════
#  FILE STORAGE — Cloudflare R2
# ══════════════════════════════════════════════════════════════════
# Where generated reports are delivered from. Free tier, zero egress fees.

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE=


# ══════════════════════════════════════════════════════════════════
#  LEDGER DATABASE
# ══════════════════════════════════════════════════════════════════
# Leave DB_HOST empty to use the local SQLite ledger (zero setup).
# Set it and the app switches to Postgres — that is what Railway uses.

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=


# ══════════════════════════════════════════════════════════════════
#  OPTIONAL — contract-intel / risk-engine degrade gracefully without these
# ══════════════════════════════════════════════════════════════════

# Ethereum contract source + ABI. Free tier is ample.
ETHERSCAN_API_KEY=

# Ethereum honeypot detection. Works without a key; the key only raises limits.
HONEYPOT_API_KEY=

# Optional. The AETH price oracle no longer uses Birdeye at all — it prices via
# DexScreener with a pump.fun bonding-curve fallback, neither of which needs a
# key. Setting this only enriches contract-intel token metadata and adds one
# more holder-distribution source; both degrade cleanly when it is empty.
BIRDEYE_API_KEY=

# Ignore pools shallower than this when pricing AETH. A price read from a thin
# pool can be pushed upward cheaply, which would reduce the number of tokens a
# payment requires.
AETH_MIN_POOL_LIQUIDITY_USD=5000


# ══════════════════════════════════════════════════════════════════
#  PRICING (USDC) — tunable from Railway without a redeploy
# ══════════════════════════════════════════════════════════════════

PRICE_PROMPT_OPTIMIZER=0.25
PRICE_CODE_EXPLAINER=0.50
PRICE_PROMPT_TESTER=0.50
PRICE_CONTRACT_INTEL=1.00
PRICE_RISK_ENGINE=0.75
PRICE_AGENT=4.99
