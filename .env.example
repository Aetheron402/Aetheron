# Aetheron: environment template
#
# Copy to .env for local development:   cp .env.example .env
# In production every one of these is set as a Railway variable instead.
# Nothing in this repo is hardcoded; if a value belongs in config, it lives here.


# ══════════════════════════════════════════════════════════════════
#  REQUIRED: the app will not boot without these
# ══════════════════════════════════════════════════════════════════

# Solana wallet that receives every payment. Mandatory by design: booting
# without it would silently route funds to the wrong place.
PAYMENT_WALLET=

# Powers all five AI components.
ANTHROPIC_API_KEY=

# The model behind every component, and the two dials that decide what a
# report costs. Effort trades quality against tokens billed: low, medium,
# high, xhigh, max. Both are read at worker start.
AETHERON_MODEL=claude-opus-5
AETHERON_EFFORT=medium
AETHERON_MAX_TOKENS=16000

# Celery broker + result backend. Local default shown.
REDIS_URL=redis://localhost:6379/0


# ══════════════════════════════════════════════════════════════════
#  TEMPORARY: component preview
# ══════════════════════════════════════════════════════════════════
# Runs each component on a fixed sample input so its output can be judged
# without paying, while the prompts are being improved. Remove before launch,
# along with dev_preview.py.
#
# Leave empty and the feature does not exist: its routes 404 and no button is
# rendered. Setting it is not enough on its own either, a browser has to visit
# /dev/unlock?token=THE_VALUE once to receive a cookie.
#
# Use a long random value, since anyone holding it can run components at your
# expense:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_TOKEN=


# ══════════════════════════════════════════════════════════════════
#  SOLANA
# ══════════════════════════════════════════════════════════════════

# Defaults to the public mainnet RPC, which is heavily rate limited.
# Use the Helius RPC URL in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana RPC + token holder lookups (contract-intel, risk-engine).
HELIUS_API_KEY=

# Leave EMPTY until the relaunched token exists.
# Setting this activates AETH payments across the whole app with no redeploy:
# while it is empty the AETH option is hidden and everything stays USDC-only.
AETH_MINT_ADDRESS=

# Canonical mainnet USDC mint. Only change this to target devnet.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v


# ══════════════════════════════════════════════════════════════════
#  FILE STORAGE (optional)
# ══════════════════════════════════════════════════════════════════
# Leave all of this empty and generated reports are stored in the ledger
# database and served from /download. That is the supported default and needs
# no third-party account.
#
# Fill it in to offload delivery to Cloudflare R2 instead, worth doing only
# once report volume makes database storage awkward.

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE=

# Reject any single generated report larger than this, in bytes. A runaway
# generation should fail loudly rather than fill the database.
MAX_ASSET_BYTES=20971520


# ══════════════════════════════════════════════════════════════════
#  LEDGER DATABASE
# ══════════════════════════════════════════════════════════════════
# Holds the payment ledger and, unless R2 is configured, the generated
# reports themselves.
#
# Leave all of this empty to use the local SQLite ledger (zero setup).
# Set either DATABASE_URL or DB_HOST and the app switches to Postgres.
#
# On Railway, set DATABASE_URL to the reference ${{Postgres.DATABASE_URL}}
# and leave the DB_* fields below empty. One variable, and it keeps working
# if the database credentials rotate.
DATABASE_URL=

# Only needed for a Postgres that does not publish a URL. Ignored when
# DATABASE_URL is set.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=


# ══════════════════════════════════════════════════════════════════
#  OPTIONAL: contract-intel / risk-engine degrade gracefully without these
# ══════════════════════════════════════════════════════════════════

# Ethereum contract source + ABI. Free tier is ample.
ETHERSCAN_API_KEY=

# Ethereum honeypot detection. Works without a key; the key only raises limits.
HONEYPOT_API_KEY=

# Optional. The AETH price oracle no longer uses Birdeye at all: it prices via
# DexScreener with a pump.fun bonding-curve fallback, neither of which needs a
# key. Setting this only enriches contract-intel token metadata and adds one
# more holder-distribution source; both degrade cleanly when it is empty.
BIRDEYE_API_KEY=

# Ignore pools shallower than this when pricing AETH. A price read from a thin
# pool can be pushed upward cheaply, which would reduce the number of tokens a
# payment requires.
AETH_MIN_POOL_LIQUIDITY_USD=5000


# ══════════════════════════════════════════════════════════════════
#  PRICING (USDC): tunable from Railway without a redeploy
# ══════════════════════════════════════════════════════════════════

PRICE_PROMPT_OPTIMIZER=0.25
PRICE_CODE_EXPLAINER=0.50
PRICE_PROMPT_TESTER=0.50
PRICE_CONTRACT_INTEL=1.00
PRICE_RISK_ENGINE=0.75
PRICE_AGENT=4.99
