{
  "general": {
    "agent_name": "alpha-scanner",
    "timezone": "UTC",
    "max_opportunities": 10,
    "log_level": "INFO",
    "run_interval_seconds": 10
  },

  "signals": {
    "enabled": {
      "social": true,
      "onchain": true,
      "market": true
    },

    "weights": {
      "social": 1.0,
      "onchain": 1.3,
      "market": 0.9
    },

    "normalization": {
      "min_value": 0.0,
      "max_value": 1.0
    },

    "confidence_floor": {
      "social": 0.4,
      "onchain": 0.6,
      "market": 0.5
    }
  },

  "social": {
    "min_mentions": 5,
    "min_unique_accounts": 3,
    "velocity_window_minutes": 60,
    "keyword_blacklist": [],
    "max_keywords_per_narrative": 5
  },

  "onchain": {
    "min_wallets_in_cluster": 3,
    "min_net_flow_usd": 100000,
    "cluster_confidence_threshold": 0.7,
    "ignore_known_cex_wallets": true
  },

  "market": {
    "min_volume_change": 1.5,
    "min_liquidity_change": 1.2,
    "lookback_minutes": 30,
    "volatility_filter": true
  },

  "narratives": {
    "min_signals": 2,
    "max_signals": 50,
    "max_active_narratives": 25,
    "merge_similarity_threshold": 0.8
  },

  "fusion": {
    "min_signal_sources": 2,
    "require_onchain_confirmation": false,
    "source_balance_penalty": true
  },

  "decay": {
    "signal_half_life_hours": 6,
    "narrative_half_life_hours": 24,
    "momentum_decay_hours": 12
  },

  "ranking": {
    "method": "weighted",
    "min_fused_strength": 0.4,
    "momentum_weight": 0.5,
    "freshness_weight": 0.3,
    "strength_weight": 0.7
  },

  "confidence": {
    "min_confidence": 0.35,
    "max_confidence": 1.0,
    "source_diversity_bonus": true,
    "onchain_bonus_multiplier": 1.2
  },

  "risk": {
    "enabled": {
      "noise": true,
      "recycled": true,
      "regime": true
    },

    "noise": {
      "min_strength": 0.5,
      "min_signals": 2
    },

    "recycled": {
      "cooldown_hours": 24
    },

    "regime": {
      "min_fused_strength": 0.5
    }
  },

  "output": {
    "include_reasons": true,
    "include_source_scores": true,
    "include_metadata": true
  }
}
